# Copy this file to .env and replace the values marked "change-me".
# The real .env is ignored by git and must never be committed.

# --- Database (read by the backend and by the db container) ---
DB_ROOT_PASSWORD=change-me
DB_NAME=task_manager
DB_USER=app
DB_PASSWORD=change-me

# --- Backend ---
# The origin of the frontend, sent as Access-Control-Allow-Origin.
# If it is missing or empty the backend sends no CORS header and logs an error.
FRONT_URL=change-me

# --- Frontend ---
# The address of the backend API, read by Vite when the dev server starts.
# Anything starting with VITE_ ends up in the JavaScript sent to the browser,
# so never put a secret in a VITE_ variable.
VITE_API_URL=change-me